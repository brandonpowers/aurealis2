{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Debug)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AUREALIS2_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AUREALIS2_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "web",
      "displayName": "WebAssembly (Emscripten)",
      "binaryDir": "${sourceDir}/build-web",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AUREALIS2_BUILD_WEB": "ON",
        "AUREALIS2_BUILD_VST3": "OFF",
        "AUREALIS2_BUILD_TESTS": "OFF"
      },
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
